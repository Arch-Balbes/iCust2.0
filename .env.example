# Шаблон. Настоящий .env создаёт scripts/new-env.ps1 (случайные пароли). .env не коммитить.
APP_ENV=local

POSTGRES_DB=icust
POSTGRES_USER=icust
POSTGRES_PASSWORD=change-me

MINIO_ACCESS_KEY=icust
MINIO_SECRET_KEY=change-me-min-8-chars
MINIO_BUCKET=icust

# Ключи внешних API храните в secrets.env (не в git), см. secrets.env.example
