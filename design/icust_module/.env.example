# Скопируйте в .env (в папке, откуда запускается сервис) и заполните. .env не коммитить.

# Ключ Cloud.ru Foundation Models — обязателен
CLOUDRU_API_KEY=

# Данные снапшота
ICUST_RAW_DIR=/path/to/data/raw/2026-11-09
ICUST_PROCESSED_DIR=/path/to/data/processed/2026-11-09

# Необязательно
# ICUST_DEVICE=auto              # auto | cuda | mps | cpu — для моделей retrieval
# ICUST_LLM_TIMEOUT=180          # тайм-аут одного запроса к LLM, с
# ICUST_LLM_MAX_RETRIES=3        # повторов при 429 / 5xx / тайм-ауте
# ICUST_LLM_CACHE_DIR=           # кэш ответов LLM на диске — только для отладки; в проде не задавать
